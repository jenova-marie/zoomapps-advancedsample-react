    "http-proxy-middleware": "^2.0.9",
    "jwt-decode": "^3.1.2",
    "morgan": "^1.10.0",
    "path-to-regexp": "^8.1.0",
    "pug": "^3.0.2-canary-5",
    "react-router-dom": "^5.2.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "on-headers": "1.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "eslint": "^7.17.0",
